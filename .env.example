# Platform public API base (no trailing slash)
VITE_PLATFORM_BASE_URL=https://platform-development-dev.157.20.214.214.nip.io

# Preferred: one client id for both categories + products
VITE_PLATFORM_PUBLIC_CLIENT_ID=a3ea1cda-c735-4798-8219-54bbb07795a9

# Used to build the payment gateway return_url. Important when you complete payment on a different device
# (e.g. scan a QR on your phone). Use your deployed domain or your PC LAN IP (e.g. http://192.168.1.10:8080).
# VITE_APP_ORIGIN=http://localhost:8080

# Optional overrides if categories/products use different client ids
# VITE_PLATFORM_CATEGORIES_CLIENT_ID=YOUR_CATEGORIES_CLIENT_ID
# VITE_PLATFORM_PRODUCTS_CLIENT_ID=YOUR_PRODUCTS_CLIENT_ID
# VITE_PLATFORM_PRODUCT_DETAILS_CLIENT_ID=YOUR_PRODUCT_DETAILS_CLIENT_ID

# Authenticated APIs (cart/wishlist/orders) may use a different client id
# VITE_PLATFORM_CART_CLIENT_ID=YOUR_CART_CLIENT_ID
# VITE_PLATFORM_WISHLIST_CLIENT_ID=YOUR_WISHLIST_CLIENT_ID
# VITE_PLATFORM_USERS_CLIENT_ID=YOUR_USERS_CLIENT_ID
# VITE_PLATFORM_ORDERS_CLIENT_ID=YOUR_ORDERS_CLIENT_ID  # Only needed if orders/payments are configured on a different client
